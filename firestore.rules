rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // Must match ADMIN_EMAIL in src/services/authService.ts
    function isAdmin() {
      return emailVerified() && request.auth.token.email == 'ehangal625@gmail.com';
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A registered, email-verified and active user
    function isMember() {
      return emailVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().active == true;
    }

    // Lesson content and site-wide settings: members read, only the admin writes
    match /topics/{topicId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    match /userPermissions/{userId} {
      allow read: if isAdmin() || (isMember() && myProfile().userId == userId);
      allow write: if isAdmin();
    }

    // Profiles: created by their owner at registration, together with the phone document
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'userId', 'email', 'phoneNumber', 'lastName',
             'firstName', 'fullName', 'school', 'accountType', 'grades', 'active', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.accountType in ['student', 'teacher']
        && request.resource.data.phoneNumber.matches('^[0-9]{8}$')
        && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phoneNumber)).data.uid == uid;

      // Owners may change only their name and phone (the new phone document must be theirs)
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phoneNumber'])
        && request.resource.data.phoneNumber.matches('^[0-9]{8}$')
        && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phoneNumber)).data.uid == uid
      );

      allow delete: if isAdmin();
    }

    // Phone number -> account, for phone sign-in and to keep numbers unique.
    // "create" only succeeds when the number is free.
    match /phones/{phone} {
      allow get: if true;
      allow create: if signedIn()
        && phone.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        // Only the number on the owner's profile (written in the same batch) can be claimed
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == phone;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Topic unlock requests: members create their own, the admin manages them
    match /accessRequests/{requestId} {
      allow create: if isMember()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Anything not matched above is denied.
  }
}
