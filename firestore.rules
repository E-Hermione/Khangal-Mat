rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return emailVerified() && request.auth.token.email == 'ehangal625@gmail.com';
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember() {
      return emailVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().active == true;
    }

    match /topics/{topicId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    // Mirrors answersVisibleFor() in src/services/answers.ts
    function answersVisible(topicId) {
      let v = get(/databases/$(database)/documents/settings/visibility).data;
      let override = v.get('topicOverrides', {}).get(topicId, {});
      return override.get('answers', v.get('defaultSections', {}).get('answers', false)) == true;
    }

    // Answers and solutions: the admin, or members once the admin shows that topic's answers
    match /topicAnswers/{topicId} {
      allow read: if isAdmin() || (isMember()
        && exists(/databases/$(database)/documents/settings/visibility)
        && answersVisible(topicId));
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    match /userPermissions/{userId} {
      allow read: if isAdmin() || (isMember() && myProfile().userId == userId);
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'userId', 'email', 'phoneNumber', 'lastName',
             'firstName', 'fullName', 'school', 'accountType', 'grades', 'active', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.accountType in ['student', 'teacher']
        && request.resource.data.phoneNumber.matches('^[0-9]{8}$')
        && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phoneNumber)).data.uid == uid;

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phoneNumber'])
        && request.resource.data.phoneNumber.matches('^[0-9]{8}$')
        && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phoneNumber)).data.uid == uid
      );

      allow delete: if isAdmin();

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }

      // Announcements sent to a group: the admin writes a copy for each recipient
      match /inbox/{announcementId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if isAdmin();
      }

      // When the user read an announcement
      match /announcementReads/{announcementId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read, delete: if isAdmin();
      }

      // Placement test result (the learning plan): the student saves it once; the admin can
      // remove it so the student takes the test again
      match /placement/{docId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }

      // Exam results: the owner writes, the admin can review
      match /examAttempts/{examId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }
    }

    // Announcements: members see the ones sent to everyone; group ones arrive in users/{uid}/inbox
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isMember() && resource.data.audience == 'all');
      allow write: if isAdmin();
    }

    // The admin counts who read each announcement
    // The admin counts who took a placement test
    match /{path=**}/placement/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/announcementReads/{announcementId} {
      allow read, delete: if isAdmin();
    }

    // Bank transfer reports: the student says they paid, the admin confirms or rejects
    match /paymentRequests/{requestId} {
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == myProfile().userId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'userId', 'phoneNumber', 'fullName', 'months', 'amount', 'note', 'status', 'createdAt']);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /phones/{phone} {
      allow get: if true;
      allow create: if signedIn()
        && phone.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == phone;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /accessRequests/{requestId} {
      allow create: if isMember()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }
  }
}
